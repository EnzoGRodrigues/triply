# Copie para .env.local e preencha

# Segredo para assinar o JWT da sessão (string aleatória longa, ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Banco de dados: "memory" (padrão — parte 1, dados em memória, voltam ao seed ao reiniciar)
# ou "postgres" (parte 2 — exige DATABASE_URL)
DB_DRIVER=memory

# --- Só no modo postgres ---
# Conexão usada pelo app (em produção na Neon: a URL "pooled")
# DATABASE_URL=postgres://usuario:senha@host:5432/triply
# Conexão direta usada pelas migrações (npm run db:migrate). Na Neon: a URL "unpooled".
# DATABASE_URL_UNPOOLED=postgres://usuario:senha@host:5432/triply
